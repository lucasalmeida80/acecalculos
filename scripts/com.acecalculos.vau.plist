<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.acecalculos.vau</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__REPO__/scripts/atualiza_vau.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <!-- Dia 3 às 10h (hora local do Mac). Repete nos dias 4 a 12 porque a SERO
       às vezes publica só no dia 4; o script é idempotente e sai na hora
       quando o mês já está no vau.json. Se o Mac estiver desligado/dormindo,
       o launchd roda na próxima vez que acordar. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Day</key><integer>3</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Day</key><integer>4</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Day</key><integer>5</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Day</key><integer>6</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Day</key><integer>7</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Day</key><integer>8</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Day</key><integer>9</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Day</key><integer>10</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Day</key><integer>11</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Day</key><integer>12</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string>
    <key>LANG</key>
    <string>pt_BR.UTF-8</string>
  </dict>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/acecalculos-vau.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/acecalculos-vau.launchd.log</string>
</dict>
</plist>
